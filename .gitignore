# 运行时产物
node_modules/
*.log
.tmp/

# profile 备份（由 install.mjs 生成，机器相关）
scripts/profile.package.json.bak

# 一次性调试脚本：按 HANDOVER §十一 判定为可丢弃，留在磁盘上但不进版本库。
# 需要保留历史时用 git add -f scripts/one-off 单独纳入。
scripts/one-off/

# 交接文档的生成物：源文件是 HANDOVER.md，改了 .md 就要重跑 scripts/md_to_docx.py，
# 否则仓库里的 Word/PDF 会悄悄过期（曾发生过一次）。
HANDOVER.docx
HANDOVER.pdf

# 测试脚本的临时目录（TEMP 没配时会退到当前目录，落进仓库——已发生过一次）
dsh-tts-*/

# 系统
Thumbs.db
desktop.ini
.DS_Store
