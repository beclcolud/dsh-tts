{
  "name": "dsh-tts",
  "version": "0.3.0",
  "description": "本地配音工作台：文案转人声 + 逐句字幕（可出成片），中/英/日三语，可离线翻译；支持按 PR 时间轴分段配音、原片反听字幕、句子级重录拼回。",
  "meta": {
    "title": "配音 TTS",
    "description": "本地配音：文案转人声 + 逐句字幕（可出成片），中/英/日，离线可翻译。"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib",
    "server",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "tts",
    "qwen3-tts",
    "voiceover"
  ],
  "license": "MIT"
}
